<%- include('partials/header') %>

<style>

.cart-title{

text-align:center;
font-size:32px;
margin:30px;
color:#ff6600;

}


.notice{

text-align:center;
font-size:20px;
color:gray;
margin:40px;

}


.cart-table{

width:90%;
margin:auto;
border-collapse:collapse;
background:white;
box-shadow:0 0 10px rgba(0,0,0,0.2);

}


.cart-table th{

background:#111;
color:white;
padding:15px;

}


.cart-table td{

padding:15px;
text-align:center;
border-bottom:1px solid #ddd;

}


.cart-table img{

width:70px;
border-radius:8px;

}


.prod{

display:flex;
align-items:center;
gap:15px;

}


.prod a{

text-decoration:none;
font-weight:bold;
color:#333;

}


.prod a:hover{

color:#ff6600;

}


button{

padding:6px 12px;
border:none;
border-radius:5px;
cursor:pointer;

}


button:hover{

opacity:0.8;

}


.btn{

padding:10px 20px;
border-radius:5px;
text-decoration:none;

}


.primary{

background:#ff6600;
color:white;

}


.danger{

background:red;
color:white;

}


.total{

width:90%;
margin:30px auto;
text-align:right;
font-size:22px;

}


.checkout{

margin-left:20px;
background:green;
color:white;

}

</style>



<h1 class="cart-title">🛒 Your Shopping Cart</h1>


<% if (!items || items.length === 0) { %>

<div class="notice">

Your cart is empty 🛒

</div>


<% } else { %>


<table class="cart-table">

<thead>

<tr>

<th>Product</th>

<th>Qty</th>

<th>Price</th>

<th>Total</th>

<th>Action</th>

</tr>

</thead>



<tbody>

<% items.forEach(it => { const imgs = JSON.parse(it.images || '[]'); %>


<tr>


<td class="prod">

<img src="public/images/laptop2.jpg" width="120">
<a href="/products/<%= it.slug %>">

<%= it.title %>

</a>

</td>



<td>

<form action="/cart/update" method="post">

<input type="hidden" name="_csrf" value="<%= csrfToken %>">

<input type="hidden" name="itemId" value="<%= it.id %>">

<input type="number" name="qty" value="<%= it.qty %>" min="0">

<button class="primary">Update</button>

</form>

</td>



<td>

₹<%= it.price %>

</td>



<td>

₹<%= (it.price * it.qty).toFixed(2) %>

</td>



<td>

<form action="/cart/remove" method="post">

<input type="hidden" name="_csrf" value="<%= csrfToken %>">

<input type="hidden" name="itemId" value="<%= it.id %>">

<button class="danger">Remove</button>

</form>

</td>



</tr>


<% }) %>

</tbody>


</table>



<div class="total">

<strong>Total: ₹<%= total.toFixed(2) %></strong>

<a class="btn checkout" href="/orders/checkout">

Checkout

</a>

</div>



<% } %>


<%- include('partials/footer') %>